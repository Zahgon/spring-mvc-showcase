{
  "name": "spring-mvc-showcase",
  "version": "1.0.0",
  "description": "Demonstrates the capabilities of the Spring MVC web framework through small, simple examples",
  "homepage": "https://github.com/spring-attic/spring-mvc-showcase",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/main.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "start": "npm run build && node --enable-source-maps dist/main.js",
    "dev": "tsx src/main.ts",
    "build": "tsc --build tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
